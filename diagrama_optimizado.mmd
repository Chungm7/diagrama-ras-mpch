%% =========================================================================
%% PROCEDIMIENTO ADMINISTRATIVO SANCIONADOR (PAS) - MPCH
%% REGLAMENTO DE APLICACIÓN DE SANCIONES (RAS MODIFICADO 2026)
%% FLUJO INTEGRAL: CARGOS, ÁREAS, ACCIONES DEL ADMINISTRADO Y REGIMEN DE PAGOS
%% =========================================================================

INI(["🏁 <b>INICIO DEL PROCEDIMIENTO (PAS)</b><br/><small>Municipalidad Provincial de Chiclayo • Jurisdicción Distrital</small>"]):::termStart

%% =========================================================================
%% FASE 1: DETECCIÓN Y FISCALIZACIÓN DE CAMPO (SUBGERENCIA DE FISCALIZACIÓN)
%% =========================================================================
subgraph FASE1 ["📡 FASE 1: DETECCIÓN Y FISCALIZACIÓN DE CAMPO (SUBGERENCIA DE FISCALIZACIÓN)"]
    direction TB
    
    ORIG{"¿Canal de Detección<br/>de la Infracción?"}:::decision
    OR_PATRULLA["🚓 <b>Patrullaje Municipal de Campo</b><br/><small>Dpto. de Fiscalización y Control Operacional (Art. 4.9, 5.1.a)</small>"]:::proceso
    OR_APP["📱 <b>Denuncia Digital: Chiclayo Reporta</b><br/><small>Monitoreada por CECOM - Central de Comunicaciones (Art. 24)</small>"]:::proceso
    OR_MESA["🏛️ <b>Mesa de Partes Municipal</b><br/><small>Servidor recepciona denuncia escrita o levanta acta verbal (Art. 24)</small>"]:::proceso

    RRHH_NOT["📋 <b>Resolución de Gerencia de RR.HH.</b><br/><small>Designa y acredita a Fiscalizadores con fotocheck y RAS/CUIS (Disp. Final 7ma)</small>"]:::nota

    F1["👮 <b>Fiscalizador Municipal In Situ</b><br/><small>Acreditado formalmente. Acompañan Inspectores Técnicos (Sanidad, Obras, etc. Art. 4.7)</small>"]:::destacado
    
    ADM_FACILIDADES["🧑💼 <b>ADMINISTRADO FISCALIZADO:</b><br/><small>Se identifica con DNI, brinda facilidades (Art. 28) o presenta pruebas en 5 días (Art. 27.e, 34)</small>"]:::admin

    D1_FISC{"¿Administrado subsana<br/>la conducta in situ?"}:::decision
    E1(["✅ <b>Abstención de Imposición</b><br/><small>Fiscalizador suscribe Acta de Verificación de conformidad</small><br/><code>📌 CERRADO_SIN_INFRACCION</code>"]):::termOk
    
    D2_FISC{"¿Se logra identificar<br/>al presunto infractor?"}:::decision
    F2["🔍 <b>Indagación Previa de Identificación</b><br/><small>Fiscalizador redacta Acta de Verificación con testigos presenciales (Art. 30.1.i)</small>"]:::proceso
    D3_FISC{"¿Identificado tras cruce<br/>con dependencias estatales?"}:::decision
    E2(["🗄️ <b>Archivo por No Identificación</b><br/><small>Fiscalizador remite informe sustentado de archivo a Subgerencia (Art. 30.1.iii)</small><br/><code>📌 ARCHIVADO_SIN_IDENTIFICAR</code>"]):::termWarn
    
    F3["📄 <b>Imposición de Papeleta de Infracción</b><br/><small>Fiscalizador Municipal notifica in situ Acta de Fiscalización (Arts. 29, 33)</small><br/><code>📌 PAPELETA_IMPUESTA</code>"]:::destacado
    
    F3_MEDIDAS[["⚡ <b>Medidas Correctivas Inmediatas al Término de Fiscalización (Art. 64)</b><br/><small>• Subgerente de Fiscalización: Acta de Clausura Temporal (Ley 31914 / Art. 65.a)<br/>• Fiscalizador: Acta de Paralización de Obra (Art. 30.3, 70)<br/>• Policía Municipal: Retención de Bienes en vía pública (Art. 66)<br/>• Subgerencia de Sanidad: Decomiso y Destrucción de alimentos no aptos (Art. 67)</small><br/>➡️ <i>(Ver Módulo: Procedimientos Especiales)</i>"]]:::salto
    
    INHIB_SATCH["🚫 <b>Inhibición Legal de Cobro SATCH (Art. 17):</b><br/><small>Si se aplicó Clausura Temporal in situ, SAT Chiclayo se inhibe del cobro de papeleta</small>"]:::alerta

    D_PAGO1{"🧑💼 <b>ADMINISTRADO: ¿Opta por Pronto Pago?</b><br/><small>Art. 16.a RAS: Plazo de 5 días hábiles tras la papeleta</small>"}:::decision
    T1_PRONTO(["💰 <b>PAGO PRONTO PAGO: PAGA EL 40% (60% DESCUENTO)</b><br/><small>Art. 16.a RAS: Cancela al contado en 5 días hábiles SIN ingresar descargos</small><br/><code>📌 CONCLUIDO_PRONTO_PAGO_40</code>"]):::pago

    S1_SEC["🗂️ <b>Derivación a Etapa Instructora</b><br/><small>Fiscalizador remite papeletas, actas e informes diarios a Subgerencia (Art. 5.1.d)</small><br/><code>📌 REGISTRADO_Y_DERIVADO</code>"]:::proceso
end

%% =========================================================================
%% FASE 2: INSTRUCCIÓN FORMAL (SUBGERENCIA DE FISCALIZACIÓN)
%% =========================================================================
subgraph FASE2 ["⚖️ FASE 2: INSTRUCCIÓN FORMAL (SUBGERENCIA DE FISCALIZACIÓN - ÓRGANO INSTRUCTOR)"]
    direction TB
    
    L1_DEP_ADM["⚖️ <b>Dpto. Administrativo (Subgerencia Fiscalización)</b><br/><small>Abogados recepcionan expediente, sistematizan y efectúan control de legalidad (Art. 4.9)</small>"]:::proceso
    
    D_PAGO2{"🧑💼 <b>ADMINISTRADO: ¿Opta por Pago Anticipado?</b><br/><small>Art. 16.b RAS: Del día 6 hasta antes de notificar Inicio del PAS</small>"}:::decision
    T2_PAGO_ANT(["💰 <b>PAGO ANTICIPADO: PAGA EL 60% (40% DESCUENTO)</b><br/><small>Art. 16.b RAS: Cancela al contado previo a imputación formal SIN presentar descargos</small><br/><code>📌 CONCLUIDO_PAGO_ANTICIPADO_60</code>"]):::pago

    D5_EXIM{"🧑💼 <b>ADMINISTRADO: ¿Acredita subsanación previa?</b><br/><small>Voluntaria antes de notificación de inicio (Arts. 39.e, 40 RAS)</small>"}:::decision
    EX_PLENO(["✅ <b>EXIMENTE PLENO: PAGA 0% (SIN MULTA NI SANCIÓN)</b><br/><small>Subgerente emite resolución disponiendo conclusión y archivo sin registro de infractor</small><br/><code>📌 CONCLUIDO_EXIMENTE_PLENO_0</code>"]):::termOk

    D4_EVAL1{"¿Dpto. Administrativo verifica indicios<br/>y mérito para abrir el PAS?"}:::decision
    E3(["🗄️ <b>Resolución de Improcedencia de Inicio</b><br/><small>Subgerente suscribe archivo por atipicidad, prescripción o causales Art. 36 RAS</small><br/><code>📌 ARCHIVADO_IMPROCEDENTE</code>"]):::termWarn
    
    L2_INFORME_LEGAL["📝 <b>Informe Legal de Apertura</b><br/><small>Dpto. Administrativo proyecta hechos imputados, norma vulnerada y posibles sanciones (Art. 4.9, 37)</small>"]:::proceso
    
    SG1_EMITE["🖋️ <b>Resolución de Inicio del PAS (Art. 37 RAS)</b><br/><small>Subgerente de Fiscalización suscribe imputación formal y confiere 5 días para descargos</small><br/><code>📌 INICIO_PAS_EMITIDO</code>"]:::destacado
    
    SG_CAUTELAR["🛡️ <b>Medidas Cautelares Provisionales de Oficio (Art. 76)</b><br/><small>Subgerente emite resolución cautelar previa opinión legal para asegurar resolución final</small>"]:::proceso
    CAUT_APEL["🧑💼 <b>ADMINISTRADO: Apelación Cautelar (Art. 79)</b><br/><small>Plazo 3 días calendario ante Subgerente. Gerente de Seg. Ciudadana resuelve en 2 días</small>"]:::admin

    N1_NOTIF1["📬 <b>Notificación Formal del Inicio del PAS</b><br/><small>Personal Notificador entrega en domicilio real, bajo puerta o casilla electrónica (Arts. 54-56)</small><br/><code>📌 INICIO_NOTIFICADO</code>"]:::proceso
    
    CAD_START[["⏱️ <b>Disparo del Plazo de Caducidad (Art. 62 RAS)</b><br/><small>9 meses perentorios (+3 prorrogables). Suspensión de prescripción (Art. 61)</small><br/>➡️ <i>(Ver Módulo: Control de Caducidad)</i>"]]:::alerta
    T2_CADUCIDAD(["⏱️ <b>Archivo por Caducidad del PAS</b><br/><small>Art. 62 RAS: Exceso de plazo sin resolver el fondo genera caducidad automática</small><br/><code>📌 ARCHIVADO_POR_CADUCIDAD</code>"]):::alerta

    D6_ADM1{"🧑💼 <b>ADMINISTRADO: ¿Formula descargos al Inicio?</b><br/><small>Plazo perentorio: 5 días hábiles (Art. 38 RAS)</small>"}:::decision
    A1_DESC1["🧑💼 <b>Presentación de Escrito de Descargos</b><br/><small>Ingresa medios probatorios y argumentos por Mesa de Partes (Art. 38)</small><br/><code>📌 DESCARGO_INICIO_INGRESADO</code>"]:::admin
    NT5_SILENCIO["⏱️ <b>Vencimiento en Rebeldía / Silencio</b><br/><small>Vencen 5 días sin descargos: trámite probatorio continúa de oficio (Art. 35, 42)</small>"]:::proceso
    
    D7_ATEN{"🧑💼 <b>ADMINISTRADO: ¿Configura Régimen Atenuante?</b><br/><small>Art. 41: Reconocimiento expreso por escrito o subsanación voluntaria post-inicio antes de IFI</small>"}:::decision
    NT6_ATEN["💰 <b>RÉGIMEN ATENUANTE: PAGA EL 70% (30% DESCUENTO)</b><br/><small>Art. 41 RAS: Multa rebajada al 70% y MPCH se inhibe de aplicar medida complementaria final</small><br/><code>📌 APLICA_ATENUANTE_30</code>"]:::pago

    L3_EVAL["⚖️ <b>Dpto. Administrativo: Calificación y Opinión Legal IFI</b><br/><small>Merita descargos, pruebas y requiere peritajes a áreas técnicas de apoyo (Art. 6, 35)</small>"]:::proceso

    D_IFI_PROP{"¿Sentido de la Opinión Legal<br/>del Dpto. Administrativo?"}:::decision
    T2_ABSOL_IFI(["✅ <b>Propuesta de Absolución y Archivo</b><br/><small>Se desvirtúan cargos en instrucción</small><br/><code>📌 IFI_PROPONE_ABSOLUCION</code>"]):::termOk

    SG2_IFI["🖋️ <b>Emisión del Informe Final de Instrucción (IFI)</b><br/><small>Subgerente de Fiscalización aprueba y suscribe motivadamente el IFI (Arts. 42, 43)</small><br/><code>📌 IFI_EMITIDO</code>"]:::destacado
end

%% =========================================================================
%% FASE 3: DECISIÓN SANCIONADORA Y RECURSOS (GERENCIA SANCIONADORA Y GM)
%% =========================================================================
subgraph FASE3 ["🏛️ FASE 3: DECISIÓN SANCIONADORA Y ETAPA RECURSIVA (GERENCIA SANCIONADORA Y GERENCIA MUNICIPAL)"]
    direction TB
    
    G_TRASLADO["🏛️ <b>Gerencia de Seguridad Ciudadana y Fiscalización</b><br/><small>Órgano Sancionador recepciona IFI y expediente completo foliado (Art. 4.10, 5.2)</small>"]:::proceso
    
    N2_NOTIF2["📬 <b>Notificación Formal del IFI al Administrado</b><br/><small>Gerente de Seguridad Ciudadana notifica el IFI confiriendo 5 días hábiles (Arts. 5.2.c, 43)</small><br/><code>📌 IFI_NOTIFICADO</code>"]:::destacado

    D1_DESC2{"🧑💼 <b>ADMINISTRADO: ¿Formula alegatos finales?</b><br/><small>Plazo de ley: 5 días hábiles tras notificación de IFI (Art. 43 RAS)</small>"}:::decision
    A1_DESC2["🧑💼 <b>Presentación de Alegatos Finales al IFI</b><br/><small>Ingresa descargos a conclusiones del IFI por Mesa de Partes</small><br/><code>📌 ALEGATOS_IFI_INGRESADOS</code>"]:::admin
    NT1_DESC2["⏱️ <b>Sin alegatos finales:</b> Expediente queda expedito para emitir resolución de fondo"]:::proceso

    G_ACT_COMP{"¿Gerente dispone actuaciones<br/>probatorias complementarias?<br/><small>(Art. 45 RAS - Excepcional)</small>"}:::decision
    
    G_EVAL_FINAL["⚖️ <b>Evaluación Resolutiva de Fondo</b><br/><small>Gerente de Seg. Ciudadana revisa IFI, descargos y pruebas (previo informe legal Art. 44)</small>"]:::proceso

    D_GER_DEC{"¿Decisión del Gerente de<br/>Seguridad Ciudadana y Fiscalización?"}:::decision
    T3_ABSOL_GER(["✅ <b>Resolución de Absolución y Archivo</b><br/><small>Gerente desestima cargos y ordena archivo definitivo del PAS</small><br/><code>📌 CONCLUIDO_ABSOLUCION_GERENCIA</code>"]):::termOk

    G1_SANCION["🔨 <b>Resolución de Sanción Administrativa (Art. 46)</b><br/><small>Gerente de Seg. Ciudadana impone multa y medidas finales: Clausura definitiva, Demolición (Art. 73) o Revocatoria (Art. 74)</small><br/><code>📌 RESOLUCION_SANCION_EMITIDA</code>"]:::destacado
    
    N1_NOTIFG["📬 <b>Notificación Formal de Resolución de Sanción</b><br/><small>Abre plazo perentorio de 15 días hábiles para pago voluntario o impugnación (Art. 46.c)</small><br/><code>📌 SANCION_NOTIFICADA</code>"]:::proceso

    D3_PAGOVOL{"🧑💼 <b>ADMINISTRADO: ¿Opta por Pago Voluntario?</b><br/><small>Art. 16.c RAS: En 15 días hábiles de notificada la sanción</small>"}:::decision
    T1_PAGOVOL(["💰 <b>PAGO VOLUNTARIO: PAGA EL 80% (20% DESCUENTO)</b><br/><small>Art. 16.c RAS: Cancela al contado en 15 días hábiles SIN interponer recursos</small><br/><code>📌 CONCLUIDO_PAGO_VOLUNTARIO_80</code>"]):::pago

    D4_RECURSO{"🧑💼 <b>ADMINISTRADO: ¿Interpone Recurso Administrativo?</b><br/><small>Plazo perentorio: 15 días hábiles (Art. 47 RAS)</small>"}:::decision
    S2_FIRMEZA["📜 <b>Declaración de Firmeza Ordinaria</b><br/><small>Vencen 15 días sin recurso ni pago: Gerente de Seg. Ciudadana emite acto de firmeza</small><br/><code>📌 RESOLUCION_FIRME_ORDINARIA</code>"]:::alerta

    D5_INDIVREC{"¿Recurso individualiza impugnación<br/>y cumple requisitos formales?"}:::decision
    REQ1_SUB["📝 <b>Requerimiento de Subsanación (Art. 48)</b><br/><small>Gerente cursa requerimiento al administrado (plazo: 2 días hábiles)</small>"]:::alerta
    D6_SUBSANA{"🧑💼 <b>ADMINISTRADO: ¿Subsana omisión en 2 días?</b>"}:::decision
    IMPROC(["🛑 <b>Resolución de Improcedencia</b><br/><small>Rechazo liminar: sanción queda firme de pleno derecho y pasa a coactiva</small><br/><code>📌 RECURSO_IMPROCEDENTE</code>"]):::termWarn

    D7_TIPOREC{"¿Qué recurso administrativo<br/>interpone el administrado?"}:::decision

    RECON1_RES["🏛️ <b>Recurso de Reconsideración (Art. 49)</b><br/><small>Administrado adjunta NUEVA PRUEBA instrumental. Gerente de Seg. Ciudadana resuelve en 15 días</small>"]:::proceso
    D8_RECONCONF{"¿Gerente de Seguridad Ciudadana<br/>confirma la sanción original?"}:::decision
    REVMOD1(["✅ <b>Sanción Revocada en Reconsideración</b><br/><small>Gerente acoge nueva prueba y deja sin efecto la multa y medidas</small><br/><code>📌 ARCHIVADO_REVOCACION_1RA</code>"]):::termOk
    D8b_APELA{"🧑💼 <b>ADMINISTRADO: ¿Apela en 15 días hábiles?</b>"}:::decision
    S_RECON_FIRME["📜 <b>Firmeza por Consentimiento en 1ra Instancia</b><br/><small>No apela en 15 días tras reconsideración: resolución firme</small><br/><code>📌 RESOLUCION_FIRME_RECON</code>"]:::alerta

    APEL1_ELEV["⚖️ <b>Recurso de Apelación (Art. 50)</b><br/><small>Puro derecho o distinta interpretación de pruebas. Gerente eleva a Gerencia Municipal (Art. 5.2.d)</small>"]:::proceso
    M1_GM["🏛️ <b>Resolución de Gerencia Municipal (Art. 4.4, 5.3)</b><br/><small>Gerente Municipal evalúa y resuelve en última instancia: AGOTA LA VÍA ADMINISTRATIVA</small>"]:::destacado
    D9_APELCONF{"¿Gerente Municipal<br/>confirma la sanción?"}:::decision
    REVMOD2(["✅ <b>Sanción Revocada en 2da Instancia</b><br/><small>Gerente Municipal declara fundado el recurso: archivo definitivo</small><br/><code>📌 ARCHIVADO_REVOCACION_2DA</code>"]):::termOk
    S3_FIRME["📜 <b>Resolución Firme con Vía Administrativa Agotada</b><br/><small>Gerencia Municipal devuelve expediente a Gerencia de Seg. Ciudadana para cobro coactivo (Art. 5.3.d)</small><br/><code>📌 VIA_ADMINISTRATIVA_AGOTADA</code>"]:::alerta
end

%% =========================================================================
%% FASE 4: EJECUCIÓN COACTIVA Y EXTINCIÓN (SATCH)
%% =========================================================================
subgraph FASE4 ["🚨 FASE 4: EJECUCIÓN COACTIVA Y EXTINCIÓN (SERVICIO DE ADMINISTRACIÓN TRIBUTARIA - SATCH)"]
    direction TB
    
    EC1["⚔️ <b>Oficio de Remisión al SATCH (Art. 5.2.e, 81)</b><br/><small>Gerente de Seg. Ciudadana oficia expediente sancionador con título ejecutivo al SAT Chiclayo</small><br/><code>📌 DERIVADO_A_COACTIVA</code>"]:::destacado
    
    D_ONEROSO{"¿SATCH declara la multa como<br/>de Recuperación Onerosa?<br/><small>(Art. 84 RAS: costo supera cobranza)</small>"}:::decision
    T_ONEROSA(["🗄️ <b>Anulación por Onerosidad (Art. 84)</b><br/><small>Resolución motivada del SATCH anula la multa por ser antieconómica su recuperación</small><br/><code>📌 ANULADA_POR_ONEROSIDAD</code>"]):::termWarn

    EC2["🔔 <b>Resolución de Ejecución Coactiva - REC (Art. 82)</b><br/><small>Ejecutor Coactivo (Dpto. Ejecución Coactiva) notifica requerimiento con 7 días hábiles de plazo</small><br/><code>📌 REC_NOTIFICADA</code>"]:::destacado
    
    D_COACT_PAGA{"🧑💼 <b>ADMINISTRADO: ¿Cancela deuda en Coactiva?</b><br/><small>Exigible 100% de la multa + costas y gastos procesales liquidados</small>"}:::decision
    EC4["🏦 <b>Pago en Ventanilla SATCH: PAGA EL 100% + COSTAS</b><br/><small>Cancelación íntegra de multa oficializada y aranceles procesales (Art. 82)</small><br/><code>📌 MULTA_PAGADA_100_COACTIVA</code>"]:::pago
    EC5(["✅ <b>Extinción y Archivo Definitivo del PAS</b><br/><small>Ejecutor Coactivo levanta gravámenes, cierra REC y archiva definitivamente</small><br/><code>📌 ARCHIVADO_EXTINCION_COACTIVA</code>"]):::termOk
    
    EC_FORZOSA["🚨 <b>Medidas Cautelares de Embargo Coactivo (Art. 82)</b><br/><small>Ejecutor traba retención de cuentas bancarias, secuestro conservativo e inscripciones registrales</small>"]:::alerta
    EC_MEDIDAS_NOPEC["🔨 <b>Ejecución Forzosa de Medidas No Pecuniarias:</b><br/><small>• Clausura forzosa con soldadura y tapiado<br/>• Demolición coactiva con auxilio de la fuerza pública (PNP) y Gerencia de Desarrollo Urbano (Art. 73)<br/>• Obras con cuenta a cargo del infractor (Art. 75)</small><br/><code>📌 CONCLUIDO_EJECUCION_FORZOSA</code>"]:::termWarn
end

