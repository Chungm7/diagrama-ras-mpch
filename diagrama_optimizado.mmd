flowchart TD
%% =========================================================================
%% PROCEDIMIENTO ADMINISTRATIVO SANCIONADOR (PAS) - MUNICIPALIDAD PROVINCIAL DE CHICLAYO
%% BASE NORMATIVA: RAS / CUIS / LEY N° 27444 / SATCH
%% VERSIÓN OPTIMIZADA: MAPEO INTEGRAL DE CONCLUSIÓN POR FASE Y FLUJO SIN CRUCES
%% =========================================================================

INI(["🏁 <b>INICIO DEL PROCEDIMIENTO (PAS)</b><br/><small>Municipalidad Provincial de Chiclayo</small>"]):::termStart

%% =========================================================================
%% FASE 1: DETECCIÓN Y FISCALIZACIÓN DE CAMPO
%% =========================================================================
subgraph FASE1 ["📡 FASE 1: DETECCIÓN Y FISCALIZACIÓN DE CAMPO (SUBGERENCIA DE FISCALIZACIÓN)"]
    direction TB
    
    ORIG{"¿Canal de<br/>Detección?"}:::decision
    OR_PATRULLA["🚓 <b>Patrullaje Municipal de Campo</b><br/><small>Inspección in situ ordinaria</small>"]:::proceso
    OR2["📱 <b>Denuncia Ciudadana (App / SGD)</b><br/><small>Foto + geolocalización en tiempo real</small>"]:::proceso
    OR3["☎️ <b>CECOM Central de Alertas</b><br/><small>Deriva denuncia a Subgerencia (Art. 24 RAS)</small>"]:::proceso

    F1["👮 <b>Inspección in situ (Fiscalizador)</b><br/><small>Captura de evidencia objetiva (acta, fotos, sonómetro)</small>"]:::destacado
    
    D1_FISC{"¿Administrado subsana<br/>la falta in situ?"}:::decision
    E1(["✅ <b>Abstención de Imposición</b><br/><small>Acta de Verificación y Cese in situ</small><br/><code>📌 CERRADO_SIN_INFRACCION</code>"]):::termOk
    
    D2_FISC{"¿Se logra identificar<br/>al infractor?"}:::decision
    F2["🔍 <b>Indagación Previa de Oficio</b><br/><small>Acta con testigos / Cruce interinstitucional</small>"]:::proceso
    D3_FISC{"¿Identificado tras<br/>las indagaciones?"}:::decision
    E2(["🗄️ <b>Archivo por No Identificación</b><br/><small>Informe de imposibilidad de imputación</small><br/><code>📌 ARCHIVADO_SIN_IDENTIFICAR</code>"]):::termWarn
    
    F3["📄 <b>Imposición de Papeleta de Infracción</b><br/><small>Acta de Fiscalización (Anexo II RAS) y conminación</small><br/><code>📌 PAPELETA_IMPUESTA</code>"]:::destacado
    
    D_PAGO1{"¿Opta por pago inmediato<br/>con 60% de descuento?<br/><small>(Art. 16.a RAS - 5 días hábiles)</small>"}:::decision
    T1_PRONTO(["✅ <b>Conclusión por Pago Inmediato (60% Dcto.)</b><br/><small>Art. 16.a RAS: Cancela sin presentar descargos</small><br/><code>📌 CONCLUIDO_PAGO_PRONTO_PAGO_60</code>"]):::termOk

    F3_MEDIDAS[["⚡ <b>¿Aplica Medida Complementaria Inmediata?</b><br/><small>Clausura, Retención, Decomiso o Paralización</small><br/>➡️ <i>(Ver Módulo: Procedimientos Especiales)</i>"]]:::salto

    S1_SEC["🗂️ <b>Registro y Derivación SGD</b><br/><small>Expediente pasa al Asesor Legal tras plazo de gracia (Art. 34 RAS)</small><br/><code>📌 REGISTRADO_Y_DERIVADO</code>"]:::proceso
end

%% =========================================================================
%% FASE 2: INSTRUCCIÓN FORMAL (SUBGERENCIA DE FISCALIZACIÓN)
%% =========================================================================
subgraph FASE2 ["⚖️ FASE 2: INSTRUCCIÓN FORMAL (SUBGERENCIA DE FISCALIZACIÓN)"]
    direction TB
    
    L1_ASESOR1["⚖️ <b>Control de Legalidad y Calificación</b><br/><small>Asesor Legal evalúa papeleta, pruebas y plazo de gracia</small>"]:::proceso
    
    D4_EVAL1{"¿Existen elementos<br/>para iniciar PAS?"}:::decision
    E3(["🗄️ <b>Archivo Preliminar por Falta de Mérito</b><br/><small>No se inicia PAS por causal de atipicidad o nulidad</small><br/><code>📌 ARCHIVADO_PRELIMINAR</code>"]):::termWarn
    
    L2_INICIO["📝 <b>Proyección de Resolución de Inicio</b><br/><small>Informe Legal + Proyecto de Imputación de Cargos</small><br/><code>📌 EN_EVALUACION_INICIO</code>"]:::proceso
    
    D_PAGO2{"¿Cancela multa con 40% dcto.<br/>antes de emitir Inicio?<br/><small>(Art. 16.b RAS)</small>"}:::decision
    T2_PAGO_ANT(["✅ <b>Conclusión por Pago Anticipado (40% Dcto.)</b><br/><small>Art. 16.b RAS: Cancela previo a imputación formal</small><br/><code>📌 CONCLUIDO_PAGO_ANTICIPADO_40</code>"]):::termOk

    D5_EXIM{"¿Acredita regularización voluntaria<br/>anterior a Resolución de Inicio?<br/><small>(Art. 257 Ley N° 27444)</small>"}:::decision
    
    subgraph SUB_EXIMENTE ["⚖️ Régimen de Eximentes y Atenuantes (Art. 257 TUO Ley 27444)"]
        EX2{"¿Momento de acreditación<br/>de subsanación voluntaria?"}:::decision
        EX3["<b>Bifurcación 1: Previo a Redacción</b><br/><small>Asesor proyecta y Subgerente firma Res. de Conclusión</small>"]:::proceso
        EX4["<b>Bifurcación 2: Posterior a Notificación</b><br/><small>Presenta documento tras ser notificado</small>"]:::proceso
        EX5{"¿Fecha documental es<br/>ANTERIOR al Inicio?"}:::decision
        EX6(["✅ <b>Conclusión por Eximente Pleno</b><br/><small>Archivo sin multa ni registro de infractor</small><br/><code>📌 CONCLUIDO_EXIMENTE_PLENO</code>"]):::termOk
        EX7["⚠️ <b>Canaliza como ATENUANTE (-30%)</b><br/><small>Regularizó después del inicio pero antes de IFI</small>"]:::alerta
    end
    
    SG1_EMITE["🖋️ <b>Emisión de Resolución de Inicio</b><br/><small>Subgerente de Fiscalización suscribe imputación formal</small><br/><code>📌 INICIO_EMITIDO</code>"]:::destacado
    
    N1_NOTIF1["📬 <b>Notificación de Imputación de Cargos</b><br/><small>Domicilio real o casilla electrónica (máx. 5 días hábiles)</small><br/><code>📌 INICIO_NOTIFICADO</code>"]:::proceso
    
    CAD_START[["⏱️ <b>Disparo de Cronómetro de Caducidad</b><br/><small>Cómputo perentorio de 9 meses (Art. 62 RAS / Ley 27444)</small><br/>➡️ <i>(Ver Módulo: Control de Caducidad)</i>"]]:::alerta
    T2_CADUCIDAD(["⏱️ <b>Archivo por Caducidad del PAS</b><br/><small>Art. 62 RAS: Exceso de 9 meses sin resolver el fondo</small><br/><code>📌 ARCHIVADO_POR_CADUCIDAD</code>"]):::alerta

    D6_ADM1{"¿Administrado formula<br/>descargos de ley?<br/><small>Plazo perentorio: 5 días hábiles</small>"}:::decision
    A1_DESC1["🧑💼 <b>Presentación de Escrito de Descargos</b><br/><small>Medios probatorios ingresados por Mesa de Partes</small><br/><code>📌 EN_PLAZO_DESCARGO_1</code>"]:::proceso
    NT5_SILENCIO["⏱️ <b>Vencimiento en Rebeldía / Silencio</b><br/><small>Trámite continúa de oficio sin descargos (Arts. 37.e, 38 RAS)</small>"]:::proceso
    
    L3_EVAL["⚖️ <b>Evaluación de Descargos y Actuación Probatoria</b><br/><small>Asesor Legal merita descargos, alegaciones e informes</small>"]:::proceso

    D_IFI_PROP{"¿Sentido del pronunciamiento<br/>del Órgano Instructor?"}:::decision
    T2_ABSOL_IFI(["✅ <b>Conclusión por Absolución de Cargos</b><br/><small>Desvirtúa falta imputada o no existe responsabilidad</small><br/><code>📌 CONCLUIDO_ABSOLUCION</code>"]):::termOk

    D7_ATEN{"¿Acredita regularización<br/>con efecto Atenuante?"}:::decision
    NT6_ATEN["📝 <b>Constancia de Atenuante:</b> Aplica -30% y cancelación de<br/>medida no pecuniaria en la Resolución de Sanción"]:::nota
    
    D8_APOYO{"¿Requiere informe pericial<br/>de área técnica de apoyo?<br/><small>(Sanidad, Defensa Civil, Obras)</small>"}:::decision
    
    subgraph SUB_APOYO ["🏢 Intervención de Áreas de Apoyo Técnico"]
        AP1["Recepción de requerimiento pericial"]:::proceso
        D9_APOYO{"¿Área responde en<br/>plazo razonable?"}:::decision
        ALERT1["⚠️ <b>PUNTO CIEGO CRÍTICO DE AUDITORÍA</b><br/><small>Sin plazos internos coactivos: demoras consumen caducidad</small>"]:::alerta
    end
    
    L4_PROYECTA["📝 <b>Proyección de Informe Final de Instrucción (IFI)</b><br/><small>Recomienda sanción o medidas correctivas</small><br/><code>📌 IFI_PROYECTADO</code>"]:::proceso
    
    SG2_IFI["🖋️ <b>Aprobación y Suscripción del IFI</b><br/><small>Subgerente concluye fase instructora y remite</small><br/><code>📌 IFI_ELABORADO</code>"]:::destacado
    
    N2_NOTIF2["📬 <b>Notificación Formal del IFI</b><br/><small>Garantía de defensa: abre plazo de 5 días para alegatos finales</small><br/><code>📌 IFI_NOTIFICADO</code>"]:::proceso
end

%% =========================================================================
%% FASE 3: DECISIÓN SANCIONADORA Y RECURSOS
%% =========================================================================
subgraph FASE3 ["🏛️ FASE 3: DECISIÓN SANCIONADORA Y RECURSOS (GERENCIA / 2DA INSTANCIA)"]
    direction TB
    
    D1_DESC2{"¿Presenta alegatos finales<br/>contra el IFI?<br/><small>Plazo: 5 días hábiles</small>"}:::decision
    A1_DESC2["🧑💼 <b>Alegatos Finales al IFI</b><br/><code>📌 EN_PLAZO_DESCARGO_2</code>"]:::proceso
    NT1_DESC2["⏱️ <b>Sin alegatos:</b> Expediente igual se eleva<br/>a Gerencia para resolver (Art. 42.b RAS)"]:::proceso
    
    S1_MESA2["🗂️ <b>Foliación y Derivación a Gerencia</b><br/><small>Expediente integral remitido al Órgano Sancionador</small><br/><code>📌 DERIVADO_A_GERENCIA</code>"]:::proceso
    
    L1_GESTOR["⚖️ <b>Evaluación de Fondo por Gerencia</b><br/><small>Revisión jurídica del IFI, expediente y alegatos</small><br/><code>📌 EN_RESOLUCION_FINAL</code>"]:::proceso

    D_GER_DEC{"¿Decisión del Órgano<br/>Sancionador?"}:::decision
    T3_ABSOL_GER(["✅ <b>Resolución de Absolución y Archivo</b><br/><small>Gerente desestima cargos y ordena archivo definitivo</small><br/><code>📌 CONCLUIDO_ABSOLUCION_GERENCIA</code>"]):::termOk

    G1_SANCION["🔨 <b>Resolución de Sanción Gerencial</b><br/><small>Gerente de Seg. Ciudadana resuelve en máx. 30 días hábiles</small><br/><code>📌 RESOLUCION_EMITIDA</code>"]:::destacado
    
    N1_NOTIFG["📬 <b>Notificación de Resolución de Sanción</b><br/><small>Abre plazo perentorio de 15 días hábiles para pago o recurso</small><br/><code>📌 RESOLUCION_NOTIFICADA</code>"]:::proceso
    
    D3_PAGOVOL{"¿Opta por pago voluntario<br/>con descuento?<br/><small>20% dcto. en 15 días hábiles</small>"}:::decision
    T1_PAGOVOL(["✅ <b>Conclusión por Pago Voluntario (20% Dcto.)</b><br/><small>Cierre y archivo definitivo por pago extintivo</small><br/><code>📌 CONCLUIDO_PAGO_VOLUNTARIO_20</code>"]):::termOk
    
    D4_RECURSO{"¿Interpone recurso administrativo<br/>de impugnación?<br/><small>Plazo perentorio: 15 días hábiles</small>"}:::decision
    S2_FIRMEZA["📜 <b>Declaración de Firmeza Ordinaria</b><br/><small>Vencen 15 días sin recurso: Gerencia emite Acto de Firmeza</small><br/><code>📌 RESOLUCION_FIRME</code>"]:::alerta

    D5_INDIVREC{"¿Recurso cumple requisitos<br/>formales y de admisibilidad?"}:::decision
    REQ1_SUB["📝 <b>Requerimiento de Subsanación</b><br/><small>Plazo legal improrrogable: 2 días hábiles</small>"]:::alerta
    D6_SUBSANA{"¿Subsana dentro de<br/>los 2 días hábiles?"}:::decision
    IMPROC(["🛑 <b>Recurso Improcedente</b><br/><small>Rechazo liminar: sanción queda firme de pleno derecho</small><br/><code>📌 RECURSO_IMPROCEDENTE</code>"]):::termWarn
    
    D7_TIPOREC{"¿Qué recurso administrativo<br/>interpone el administrado?"}:::decision
    
    subgraph SUB_RECURSOS ["⚖️ Procedimiento de Recursos Impugnativos (Ley 27444)"]
        RECON1_RES["🏛️ <b>Trámite de Reconsideración</b><br/><small>Gerente de Seg. Ciudadana resuelve (exige nueva prueba instrumental)</small>"]:::proceso
        D8_RECONCONF{"¿Gerencia confirma<br/>la sanción original?"}:::decision
        REVMOD1(["✅ <b>Sanción Revocada / Modificada</b><br/><small>Se deja sin efecto o reduce en Reconsideración</small><br/><code>📌 ARCHIVADO_REVOCACION_1RA</code>"]):::termOk
        D8b_APELA{"¿Administrado interpone<br/>Apelación en 15 días?"}:::decision

        APEL1_ELEV["⚖️ <b>Elevación a Segunda Instancia</b><br/><small>Remisión inmediata de actuados a Gerencia Municipal</small>"]:::proceso
        J1_JURIDICA["📖 <b>Dictamen de Asesoría Jurídica (OGAJ)</b><br/><small>Opinión técnico-legal de última instancia</small>"]:::proceso
        M1_GM["🏛️ <b>Resolución de Gerencia Municipal</b><br/><small>Segunda Instancia: Fin de la Vía Administrativa</small>"]:::destacado
        
        S_RECON_FIRME["📜 <b>Firmeza en Reconsideración</b><br/><small>Resolución consentida por falta de apelación en 15 días</small><br/><code>📌 RESOLUCION_FIRME_RECON</code>"]:::alerta
        D9_APELCONF{"¿Gerencia Municipal<br/>confirma la sanción?"}:::decision
        REVMOD2(["✅ <b>Sanción Revocada en 2da Instancia</b><br/><small>Se deja sin efecto en última instancia</small><br/><code>📌 ARCHIVADO_REVOCACION_2DA</code>"]):::termOk
        S3_FIRME["📜 <b>Firmeza en Segunda Instancia</b><br/><small>Vía administrativa definitivamente agotada</small><br/><code>📌 RESOLUCION_FIRME_2DA</code>"]:::alerta
    end
end

%% =========================================================================
%% FASE 4: EJECUCIÓN COACTIVA
%% =========================================================================
subgraph FASE4 ["🚨 FASE 4: EJECUCIÓN COACTIVA (SATCH)"]
    direction TB
    
    EC1["⚔️ <b>Derivación con Oficio y Título de Firmeza</b><br/><small>Remisión formal al SATCH para cobranza forzosa</small><br/><code>📌 DERIVADO_A_COACTIVA</code>"]:::destacado
    EC2["🔔 <b>Resolución de Ejecución Coactiva (REC)</b><br/><small>Ejecutor Coactivo notifica requerimiento (plazo 7 días)</small><br/><code>📌 EN_EJECUCION_COACTIVA</code>"]:::destacado
    
    EC3{"¿El deudor efectúa el pago<br/>de multa + costas coactivas?"}:::decision
    EC4["🏦 <b>Pago en Ventanilla / Caja SATCH</b><br/><small>Cancelación de Cancelación Total de Deuda Coactiva</small><br/><code>📌 MULTA_PAGADA_COACTIVA</code>"]:::proceso
    EC5(["✅ <b>Extinción y Archivo Definitivo del PAS</b><br/><small>Levantamiento total de gravámenes y medidas cautelares</small><br/><code>📌 ARCHIVADO_DEFINITIVO</code>"]):::termOk
    
    NT_EMBARGO["🚨 <b>Medidas Cautelares de Embargo Coactivo:</b><br/>Retención de cuentas bancarias, secuestro conservativo e inscripción"]:::alerta
    EC_FORZOSA(["🛑 <b>Conclusión por Ejecución Forzosa</b><br/><small>Satisfacción coactiva completa del crédito o clausura ejecutada</small><br/><code>📌 CONCLUIDO_EJECUCION_FORZOSA</code>"]):::termWarn
end

%% =========================================================================
%% ENLACES Y CONEXIONES CON BADGES DE ALTA VISIBILIDAD (SIN CRUCES)
%% =========================================================================

INI --> ORIG
ORIG -->|"<span class='edge-info'>📱 Denuncia ciudadana</span>"| OR2
ORIG -->|"<span class='edge-info'>🚓 Patrullaje de campo</span>"| OR_PATRULLA
OR2 --> OR3
OR3 --> F1
OR_PATRULLA --> F1

F1 --> D1_FISC
D1_FISC -->|"<span class='edge-yes'>✅ SÍ: Subsana in situ</span>"| E1
D1_FISC -->|"<span class='edge-no'>❌ NO Subsana</span>"| D2_FISC

D2_FISC -->|"<span class='edge-yes'>✅ SÍ Identificado</span>"| F3
D2_FISC -->|"<span class='edge-no'>❌ NO Identificado</span>"| F2
F2 --> D3_FISC
D3_FISC -->|"<span class='edge-yes'>✅ Sí se identifica</span>"| F3
D3_FISC -->|"<span class='edge-no'>❌ No se identifica</span>"| E2

F3 -.-> F3_MEDIDAS
F3 --> D_PAGO1
D_PAGO1 -->|"<span class='edge-yes'>✅ SÍ paga (60% dcto.)</span>"| T1_PRONTO
D_PAGO1 -->|"<span class='edge-no'>❌ NO paga / Ejerce defensa</span>"| S1_SEC

%% Enlace Fase 1 a Fase 2 (Vertical directo)
S1_SEC ==>|"<span class='edge-info'>Vencido plazo de gracia (5 días)</span>"| L1_ASESOR1

%% Enlaces Fase 2
L1_ASESOR1 --> D4_EVAL1
D4_EVAL1 -->|"<span class='edge-no'>❌ Sin mérito</span>"| E3
D4_EVAL1 -->|"<span class='edge-yes'>✅ Con mérito</span>"| L2_INICIO

L2_INICIO --> D_PAGO2
D_PAGO2 -->|"<span class='edge-yes'>✅ SÍ paga (40% dcto.)</span>"| T2_PAGO_ANT
D_PAGO2 -->|"<span class='edge-no'>❌ Continúa trámite</span>"| D5_EXIM

D5_EXIM -->|"<span class='edge-yes'>✅ Acredita regularización</span>"| EX2
D5_EXIM -->|"<span class='edge-no'>❌ No regularizó</span>"| SG1_EMITE

EX2 -->|"<span class='edge-info'>Antes de redactar inicio</span>"| EX3
EX2 -->|"<span class='edge-info'>Tras ser notificado</span>"| EX4
EX3 --> EX6
EX4 --> EX5
EX5 -->|"<span class='edge-yes'>✅ SÍ: Fecha anterior al inicio</span>"| EX6
EX5 -->|"<span class='edge-no'>❌ NO: Fecha posterior</span>"| EX7
EX7 -->|"<span class='edge-warn'>Canaliza como atenuante</span>"| L3_EVAL

SG1_EMITE -->|"<span class='edge-info'>Plazo máx. 5 días hábiles</span>"| N1_NOTIF1
N1_NOTIF1 -.-> CAD_START
CAD_START -.-> T2_CADUCIDAD

N1_NOTIF1 --> D6_ADM1
D6_ADM1 -->|"<span class='edge-yes'>✅ SÍ formula descargos</span>"| A1_DESC1
D6_ADM1 -->|"<span class='edge-no'>❌ NO formula descargos</span>"| NT5_SILENCIO
A1_DESC1 --> L3_EVAL
NT5_SILENCIO --> L3_EVAL

L3_EVAL --> D_IFI_PROP
D_IFI_PROP -->|"<span class='edge-yes'>✅ Propone Absolución</span>"| T2_ABSOL_IFI
D_IFI_PROP -->|"<span class='edge-no'>⚖️ Propone Sanción</span>"| D7_ATEN

D7_ATEN -->|"<span class='edge-yes'>✅ SÍ aplica atenuante (-30%)</span>"| NT6_ATEN
D7_ATEN -->|"<span class='edge-no'>❌ Regular</span>"| D8_APOYO
NT6_ATEN --> D8_APOYO

D8_APOYO -->|"<span class='edge-no'>No requiere</span>"| L4_PROYECTA
D8_APOYO -->|"<span class='edge-info'>Requiere peritaje</span>"| AP1
AP1 --> D9_APOYO
D9_APOYO -->|"<span class='edge-yes'>✅ Emite a tiempo</span>"| L4_PROYECTA
D9_APOYO -->|"<span class='edge-no'>⚠️ Retraso prolongado</span>"| ALERT1
ALERT1 -.-> L4_PROYECTA

L4_PROYECTA --> SG2_IFI
SG2_IFI --> N2_NOTIF2

%% Enlace Fase 2 a Fase 3
N2_NOTIF2 ==>|"<span class='edge-info'>Traslado de IFI (Notificado)</span>"| D1_DESC2
D1_DESC2 -->|"<span class='edge-yes'>✅ SÍ formula alegatos</span>"| A1_DESC2
D1_DESC2 -->|"<span class='edge-no'>❌ NO formula alegatos</span>"| NT1_DESC2
A1_DESC2 --> S1_MESA2
NT1_DESC2 --> S1_MESA2
S1_MESA2 --> L1_GESTOR

L1_GESTOR --> D_GER_DEC
D_GER_DEC -->|"<span class='edge-yes'>✅ Absuelve cargos</span>"| T3_ABSOL_GER
D_GER_DEC -->|"<span class='edge-no'>❌ Sanciona</span>"| G1_SANCION

G1_SANCION --> N1_NOTIFG
N1_NOTIFG --> D3_PAGOVOL
D3_PAGOVOL -->|"<span class='edge-yes'>✅ SÍ paga con 20% dcto.</span>"| T1_PAGOVOL
D3_PAGOVOL -->|"<span class='edge-no'>❌ NO se acoge al pago</span>"| D4_RECURSO

D4_RECURSO -->|"<span class='edge-no'>❌ Vencen 15 días sin recurso</span>"| S2_FIRMEZA
D4_RECURSO -->|"<span class='edge-yes'>✅ Interpone recurso</span>"| D5_INDIVREC

D5_INDIVREC -->|"<span class='edge-yes'>✅ Cumple requisitos</span>"| D7_TIPOREC
D5_INDIVREC -->|"<span class='edge-no'>❌ Con defectos formales</span>"| REQ1_SUB
REQ1_SUB --> D6_SUBSANA
D6_SUBSANA -->|"<span class='edge-yes'>✅ SÍ subsana a tiempo</span>"| D7_TIPOREC
D6_SUBSANA -->|"<span class='edge-no'>❌ NO subsana en 2 días</span>"| IMPROC

D7_TIPOREC -->|"<span class='edge-info'>📄 Reconsideración</span>"| RECON1_RES
D7_TIPOREC -->|"<span class='edge-info'>⚖️ Apelación</span>"| APEL1_ELEV

RECON1_RES --> D8_RECONCONF
D8_RECONCONF -->|"<span class='edge-yes'>✅ Revoca o modifica</span>"| REVMOD1
